{
  "appId": "com.cesardelossantos.culebrilla",
  "appName": "Culebrilla",
  "webDir": "www",
  "backgroundColor": "#120626",
  "android": {
    "backgroundColor": "#120626",
    "allowMixedContent": false,
    "captureInput": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#120626",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    }
  }
}
